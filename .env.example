# San Diego Clairemont SDA Church — environment template
#
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Never commit real credentials. Never add a secret to a NEXT_PUBLIC_ variable —
# anything with that prefix is inlined into the browser bundle.
#
# Validation is lazy and grouped (see src/env.ts), so the project installs,
# typechecks, lints and builds with none of these set. A group is only validated
# when code that needs it actually runs.

# ---------------------------------------------------------------------------
# Application — Phase 0
# ---------------------------------------------------------------------------

# Canonical public origin, no trailing slash. Falls back to http://localhost:3000
# when unset. Deployments MUST set this, or canonical URLs, the sitemap and social
# images will point at localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sanity — editorial CMS. Required from Phase 2.
# ---------------------------------------------------------------------------

# Public project identifier, lowercase alphanumeric. Not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"

# Usually "production". Not a secret.
NEXT_PUBLIC_SANITY_DATASET="production"

# API version as a YYYY-MM-DD date. Pinning this means Sanity API changes cannot
# alter query behaviour without a deliberate bump.
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-23"

# Server-only. Viewer token used to read drafts for Presentation and Visual
# Editing. Not needed for published content. Added in Phase 2.
# SANITY_API_READ_TOKEN=""

# Server-only. Shared secret used to verify the revalidation webhook signature.
# Added in Phase 2.
# SANITY_REVALIDATE_SECRET=""

# ---------------------------------------------------------------------------
# Supabase — auth and private application data. Required from Phase 5.
# ---------------------------------------------------------------------------

# Project URL. Not a secret.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Publishable key (sb_publishable_...). Browser-safe by design: it grants only
# what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Server-only secret key (sb_secret_...). BYPASSES ROW LEVEL SECURITY.
# Read only by src/lib/supabase/admin.ts. Never expose to the browser.
SUPABASE_SECRET_KEY="sb_secret_your_key"
