{
  "name": "sdaclairemont",
  "version": "0.1.0",
  "private": true,
  "description": "San Diego Clairemont Seventh-day Adventist Church website",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=10.18.0"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --env-file-if-exists=.env.local scripts/check-placeholders.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "check:schema": "sanity schema validate",
    "check:types": "node scripts/check-generated-types.mjs",
    "check:placeholders": "node --env-file-if-exists=.env.local scripts/check-placeholders.mjs",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate",
    "sanity:ping": "node --env-file-if-exists=.env.local scripts/sanity-ping.mjs",
    "sanity:seed": "node --env-file-if-exists=.env.local scripts/seed-sanity.mjs"
  },
  "dependencies": {
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/vision": "^6.10.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "next-sanity": "^13.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.10.1",
    "server-only": "^0.0.1",
    "styled-components": "^6.5.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
